<style>
  .container-table {
    display: none;
    background-color: #fffafa;
  }
  .box {
    padding: 0%;
    width: 100%;
    border: 1px solid green;
  }
  .row {
    padding: 20px;
  }
  .p-group {
    background-color:#foF8FF;
  }
  .tab-content {
    padding: 20px;
  }
  .heading {
    text-align: center;
    font-size: 3em;
    font-weight: bold;
  }
  .tab1 {
  }
  .styled-table {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
    font-size: 16px;
    text-align: left;
  }

  td {
    font-weight: bold;
  }

  .styled-table th,
  .styled-table td {
    padding: 12px 15px;
    border: 1px solid #dddddd;
  }

  .styled-table th {
    text-align: center;
  }

  .styled-table td {
    text-align: center;
  }

  .styled-table tr:hover {
    background-color: #f1f1f1;
  }

  .first-row {
    color: rgb(69, 66, 66);
  }

  .button-group {
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
  }

  .btn {
    padding: 10px 20px;
    color: black;
    cursor: pointer;
    outline: none;
    transition: background-color 0.3s ease;
    border: 1px solid black;
    background-color: #f1f1f1;
    margin-right: 10px;
  }

  .btn:hover {
    background-color: #ddd;
  }

  .tab-content {
    display: none;
  }
  .new-p {
    text-decoration: underline;
    font-size: 2rem;
    cursor: pointer;
    width: 50%;
    text-align: center;
  }
  .new-p1 {
    text-decoration: underline;
    font-size: 2rem;
    cursor: pointer;
    width: 50%;
    text-align: center;
  }

  .active {
    display: block;
  }

  .how-to-measure-content {
    display: table;
    margin: 0 auto;
    font-size: 18px;
    line-height: 1.6;
  }
  .p-group {
    width: 100%;
    display: Flex;
    justify-content: space-around;
  }
</style>
