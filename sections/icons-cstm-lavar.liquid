<style>
  .icon-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    margin: 20px;
  }

  .icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 10px;
    text-align: center;
  }

  .icon-item img {
    width: 100px;
    height: auto;
  }

  .icon-item p {
    margin-top: 10px;
    font-size: 1rem;
    color: #333;
  }

  @media (max-width: 768px) {
    .icon-container {
      justify-content: space-between;
    }

    .icon-item {
      width: calc(33.33% - 20px);
      margin: 10px;
    }

    .icon-item img {
      width: 80px;
    }

    .icon-item p {
      font-size: 0.9rem;
    }
  }
</style>

