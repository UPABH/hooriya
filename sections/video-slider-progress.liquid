{{ 'section-video-slider-progress.css' | asset_url | stylesheet_tag }}
<video-progress>
  <div class="video-progress__main">
    <div class="video-progress__title-wrapper">
      <div data-fade-up class="video-progress__subheading">{{ section.settings.subheading }}</div>
      <div data-fade-up class="video-progress__heading">{{ section.settings.heading }}</div>
    </div>
    <div data-fade-up class="video-progress__slideshow">
      <div data-video-progress-slider class="video-progress__container">
        <div class="swiper-wrapper video-progress__wrapper">
          {%- for block in section.blocks -%}
            <div class="swiper-slide video-progress__slide">
              <div>
                {%- if block.settings.video_element -%}
                  {%- liquid
                    assign height = block.settings.video_element.width | divided_by: block.settings.video_element.aspect_ratio | round
                    assign sizes = '100vw'
                    assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
                    assign fetch_priority = 'auto'
                    if section.index == 1
                      assign fetch_priority = 'high'
                    endif
                  -%}
                  {%- if forloop.first %}
                    {{
                      block.settings.video_element
                      | video_tag:
                        sizes: sizes,
                        widths: widths,
                        controls: false,
                        autoplay: true,
                        loop: true,
                        class: 'video-progress__video',
                        muted: true
                    }}
                  {%- else -%}
                    {{
                      block.settings.video_element
                      | video_tag:
                        sizes: sizes,
                        loading: 'lazy',
                        widths: widths,
                        loop: true,
                        controls: false,
                        class: 'video-progress__video',
                        muted: true
                    }}
                  {%- endif -%}
                {%- endif -%}
              </div>
              {% if block.settings.heading_slide != blank %}
                <div class="video-progress__video-content">
                  <div class="video-progress__content-heading">{{ block.settings.heading_slide }}</div>
                  <div class="video-progress__content-paragraph">{{ block.settings.paragraph_slide }}</div>
                </div>
              {% endif %}
            </div>
          {%- endfor -%}
        </div>

        <div class="video-progress__slideshow-control">
          <div data-pagination-video class="swiper-pagination video-progress__pagination"></div>
          <button
            type="button"
            class="video-progress__slider-button slider-button slider-button--next slider-playtoggle"
            name="next"
          >
            <span class="video-progress__pause slider-playtoggle--active" id="sliderPlay">
              {%- render 'icon-video-pause' -%}
            </span>
            <span class="video-progress__play" id="sliderPause">{%- render 'icon-video-play' -%}</span>
          </button>
        </div>
      </div>
    </div>
    <div class="video-progress__bottom-description dtf-film--container">
      <div class="video-progress__title-icon-wrapper">
        <div data-fade-up class="video-progress__description-heading video-progress__description-heading--desktop">
          {{ section.settings.desc_heading }}
        </div>
        <div data-fade-up class="video-progress__description-heading video-progress__description-heading--mobile">
          {{ section.settings.desc_heading_mobile }}
        </div>
        <div data-fade-up class="video-progress__description-icon">{{ section.settings.desc_icon }}</div>
      </div>
      <div data-fade-up class="video-progress__description">{{ section.settings.description }}</div>
    </div>
  </div>
</video-progress>

{{ 'section-video-slider-progress.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "DTF Video Slides",
  "tag": "section",
  "class": "dtf-video-slide",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section Title"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub-Heading",
      "default": "EXPLORE OUR"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SPECIAL TECHNOLOGIES."
    },
    {
      "type": "header",
      "content": "Section Description Below Slider"
    },
    {
      "type": "html",
      "id": "desc_heading",
      "label": "Heading Description"
    },
    {
      "type": "html",
      "id": "desc_heading_mobile",
      "label": "Heading Mobile Description"
    },
    {
      "type": "html",
      "id": "desc_icon",
      "label": "Icon Description"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide Name",
      "limit": 15,
      "settings": [
        {
          "type": "video",
          "id": "video_element",
          "label": "Video"
        },
        {
          "type": "text",
          "id": "heading_slide",
          "label": "Slide Heading",
          "default": "COATING"
        },
        {
          "type": "html",
          "id": "paragraph_slide",
          "label": "Slide Text",
          "default": "Realizing beautiful, vivid colors and uniform quality through consistent, high-quality coating"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DTF Video Slides Video",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
